{
  "allowedMcpServers": [
    {
      "serverUrl": "https://mcp.context7.com/mcp"
    },
    {
      "serverUrl": "https://learn.microsoft.com/api/mcp"
    },
    {
      "serverCommand": [
        "npx",
        "@playwright/mcp@latest"
      ]
    }
  ],
  "deniedMcpServers": [
    {
      "serverUrl": "https://*.unapproved.contoso.example/*"
    },
    {
      "serverCommand": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/"
      ]
    }
  ]
}
