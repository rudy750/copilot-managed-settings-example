{
  "model": "auto",
  "allowedMcpServers": [
    {
      "serverUrl": "https://mcp.context7.com/mcp"
    },
    {
      "serverUrl": "https://mcp.sentry.dev/mcp"
    }
  ],
  "deniedMcpServers": [
    {
      "serverUrl": "https://*.unapproved.contoso.example/*"
    },
    {
      "serverCommand": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/"
      ]
    },
    {
      "serverCommand": [
        "npx",
        "@playwright/mcp@latest"
      ]
    }
  ],
  "enabledPlugins": {
    "security-workflows@contoso-agent-skills": true
  }
}
